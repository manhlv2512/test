{
  "schemaVersion": 1,
  "key": "report-ekyc",
  "header": {
    "title": "Báo cáo dữ liệu eKYC",
    "description": "Tra cứu hồ sơ eKYC và kết quả xác thực sinh trắc học"
  },
  "detail": {
    "compareFields": ["idCard", "fullName", "birthday", "issueDate", "permanentAddress"],
    "emptyValueText": "—",
    "ekycFields": {
      "idCard": "Số CCCD/Thẻ CC",
      "oldIdNumber": "Số CMND cũ",
      "fullName": "Họ và tên",
      "birthday": "Ngày sinh",
      "gender": "Giới tính",
      "issuePlace": "Nơi cấp",
      "issueDate": "Ngày cấp",
      "expiryDate": "Ngày hết hạn",
      "nationality": "Quốc tịch",
      "permanentAddress": "Địa chỉ thường trú",
      "currentAddress": "Địa chỉ hiện tại"
    }
  },
  "pageSize": 10,
  "pageSizeOptions": [
    10,
    20,
    50,
    100
  ],
  "pageSizeSelect2Options": {
    "width": "72px"
  },
  "select2Options": {
    "minimumResultsForSearch": 6,
    "width": "resolve",
    "allowClear": true
  },
  "datepickerOptions": {
    "dateFormat": "dd-mm-yy",
    "searchDateFormat": "yy-mm-dd",
    "showButtonPanel": true,
    "changeMonth": true,
    "changeYear": true
  },
  "columns": [
    {
      "field": "_stt",
      "title": "STT",
      "width": 50,
      "align": "center",
      "renderer": "sttRenderer"
    },
    {
      "field": "transId",
      "title": "Trace ID",
      "width": 300,
      "minWidth": 160
    },
    {
      "field": "branch",
      "title": "ĐVKD",
      "width": 100,
      "sortable": true
    },
    {
      "field": "userId",
      "title": "Người thực hiện",
      "minWidth": 100,
      "sortable": true
    },
    {
      "field": "requestDate",
      "title": "Ngày phát sinh",
      "minWidth": 110,
      "sortable": true
    },
    {
      "field": "cif",
      "title": "CIF",
      "minWidth": 110
    },
    {
      "field": "idCard",
      "title": "CCCD",
      "minWidth": 130
    },
    {
      "field": "fullName",
      "title": "Họ tên",
      "minWidth": 160
    },
    {
      "field": "customerPhoto",
      "title": "Kết quả STH",
      "width": 110,
      "renderer": "isVerifiedBadge"
    },
    {
      "field": "customerPhoto",
      "title": "Tỷ lệ khớp",
      "width": 90,
      "renderer": "overallScoreRenderer"
    },
    {
      "field": "createdAt",
      "title": "Ngày cập nhật",
      "minWidth": 140,
      "sortable": true
    },
    {
      "type": "actions",
      "title": "Hành động",
      "width": 80,
      "actions": [
        {
          "iconClass": "fas fa-code",
          "title": "Xem log",
          "variant": "warning",
          "href": "#",
          "handler": "viewProcessLog"
        },
        {
          "iconClass": "fas fa-eye",
          "title": "Xem chi tiết",
          "variant": "info",
          "href": "#",
          "handler": "viewDetail"
        },
        {
          "iconClass": "fas fa-file-download",
          "title": "Tải xuống",
          "href": "#",
          "handler": "downloadFile"
        }
      ]
    }
  ],
  "searchFields": [
    {
      "name": "keyword",
      "label": "Từ khoá",
      "type": "text",
      "width": 400,
      "placeholder": "CIF hoặc CCCD hoặc Họ tên hoặc Người thực hiện"
    },
    {
      "name": "branch",
      "label": "ĐVKD",
      "type": "select",
      "width": 180,
      "placeholder": "Tất cả",
      "optionsProvider": "branchOptions"
    },
    {
      "name": "isVerified",
      "label": "Kết quả STH",
      "type": "select",
      "width": 180,
      "placeholder": "Tất cả",
      "options": [
        {
          "value": "1",
          "label": "Trùng khớp"
        },
        {
          "value": "0",
          "label": "Không khớp"
        }
      ]
    },
    {
      "name": "date",
      "label": "Ngày phát sinh",
      "type": "daterange",
      "width": 360,
      "fromPlaceholder": "Từ ngày",
      "toPlaceholder": "Đến ngày"
    }
  ],
  "buttons": [
    {
      "type": "dropdown",
      "iconClass": "fas fa-ellipsis-h",
      "title": "Thao tác",
      "actions": [
        {
          "text": "Export Excel",
          "iconClass": "fas fa-file-export",
          "className": "tr-toolbar-menu-export",
          "handler": "exportExcel"
        }
      ]
    }
  ],
  "events": {
    "onRowClick": "onRowClick",
    "onDataLoaded": "onDataLoaded",
    "onSearchChanged": "onSearchChanged"
  }
}