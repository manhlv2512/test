# Environment variables for the Shell Script Execution API.
# Copy to .env and adjust. These override values in config.yaml.

# API key required in the X-API-Key header when calling execute endpoints.
# X_API_KEY is preferred; SHELL_API_KEY remains a supported alias.
X_API_KEY=DC1@20263
# SHELL_API_KEY=change-me

# Base directory containing configured executable files.
SHELL_API_SCRIPTS_DIR=/u01/pipeline/scripts

# Override each action's file from config.yaml. Values may be relative to
# SHELL_API_SCRIPTS_DIR or absolute paths inside that directory.
SHELL_API_SCRIPT_DEPLOY=deploy.sh
SHELL_API_SCRIPT_UNDEPLOY=undeploy.sh
SHELL_API_SCRIPT_RESTART=restart.sh
SHELL_API_SCRIPT_BACKUP=backup.sh

# Override the listen port (used when running `python -m app.main`).
# SHELL_API_PORT=8000

# Override the log level (DEBUG, INFO, WARNING, ERROR).
# SHELL_API_LOG_LEVEL=INFO

# Override the config file path.
# SHELL_API_CONFIG=/path/to/config.yaml
