{
  "schemaVersion": 1,
  "key": "transactions-post-disb",
  "header": {
    "title": "Danh sách giao dịch hậu kiểm giải ngân"
  },
  "amountDisplay": {
    "amountField": "amount",
    "currencyField": "currency",
    "typeField": "transactionType1",
    "types": [
      "Giaingankhoanvay",
      "Giainganthauchi",
      "Khoitaohanmuc"
    ],
    "decimals": {
      "VND": 0,
      "default": 2
    }
  },
  "statusBadge": {
    "codeField": "status",
    "defaultTone": "default",
    "tones": {
      "GNCN_KHOI_TAO": "default",
      "GNCN_HUY": "default",
      "GNCN_CHO_XU_LY": "orange",
      "GNCN_CHO_BO_SUNG": "orange",
      "GNCN_DA_PHE_DUYET": "purple",
      "GNCN_LOI_HACH_TOAN_HAN_MUC": "red",
      "GNCN_LOI_HACH_TOAN_KHOAN_VAY": "red",
      "GNCN_LOI_HACH_TOAN_THAU_CHI": "red",
      "GNCN_LOI_CHUYEN_TIEN": "red",
      "GNCN_HOAN_TAT_KHOAN_VAY": "purple",
      "GNCN_HOAN_THANH": "green"
    }
  },
  "sla": {
    "statusField": "status",
    "activeStates": [
      "GNCN_CHO_XU_LY"
    ],
    "yellowField": "yellowFlagDate",
    "redField": "redFlagDate",
    "startField": "taskStartTime",
    "weekDays": [
      "Sunday",
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday"
    ]
  },
  "sort": {
    "field": "taskStartTime",
    "type": "DESC"
  },
  "pageSize": 10,
  "pageSizeOptions": [
    10,
    20,
    50,
    100
  ],
  "pageSizeSelect2Options": {
    "width": "72px"
  },
  "select2Options": {
    "minimumResultsForSearch": 6,
    "width": "resolve",
    "allowClear": true
  },
  "datepickerOptions": {
    "dateFormat": "dd-mm-yy",
    "searchDateFormat": "yy-mm-dd",
    "showButtonPanel": true,
    "changeMonth": true,
    "changeYear": true
  },
  "columns": [
    {
      "field": "_stt",
      "title": "STT",
      "width": 50,
      "align": "center",
      "renderer": "sttRenderer"
    },
    {
      "field": "_sla",
      "title": "SLA",
      "align": "center",
      "renderer": "slaRenderer",
      "className": "disb-col-fit"
    },
    {
      "type": "actions",
      "title": "Mã GNTD",
      "minWidth": 160,
      "align": "left",
      "className": "disb-col-gntd",
      "separator": false,
      "actions": [
        {
          "textField": "gntdCode",
          "href": "#",
          "title": "Xem chi tiết giao dịch",
          "className": "tr-transaction-link",
          "handler": "openTransactionDetail"
        }
      ]
    },
    {
      "field": "transactionType1Name",
      "title": "Thông tin giao dịch",
      "minWidth": 160,
      "renderer": "transactionRenderer"
    },
    {
      "field": "branchCode",
      "title": "ĐVKD",
      "align": "center",
      "className": "disb-col-fit"
    },
    {
      "field": "customerName",
      "title": "Khách hàng",
      "minWidth": 140,
      "renderer": "customerRenderer"
    },
    {
      "field": "taskStartTime",
      "title": "Thời điểm hậu kiểm",
      "width": 110,
      "align": "center",
      "sortable": true
    },
    {
      "field": "assignUser",
      "title": "User phân công",
      "className": "disb-col-fit"
    },
    {
      "field": "processUser",
      "title": "User xử lý",
      "className": "disb-col-fit"
    },
    {
      "field": "statusName",
      "title": "Trạng thái",
      "minWidth": 140,
      "maxWidth": 220,
      "renderer": "statusRenderer"
    },
    {
      "field": "taskStartTime",
      "title": "Thời điểm tiếp nhận",
      "width": 110,
      "align": "right",
      "sortable": true,
      "renderer": "dateTimeRenderer"
    }
  ],
  "searchFields": [
    {
      "name": "keyword",
      "label": "Từ khoá",
      "type": "text",
      "width": 400,
      "placeholder": "GNTD, PDTD, mã/tên KH, user xử lý"
    },
    {
      "name": "branch",
      "label": "ĐVKD",
      "type": "select",
      "width": 200,
      "placeholder": "Tất cả",
      "optionsProvider": "branchOptions"
    },
    {
      "name": "transactionType1",
      "label": "Loại giao dịch cấp 1",
      "type": "select",
      "width": 200,
      "placeholder": "Tất cả",
      "optionsProvider": "transactionType1Options"
    },
    {
      "name": "status",
      "label": "Trạng thái",
      "type": "select",
      "width": 200,
      "placeholder": "Tất cả",
      "multiple": true,
      "optionsProvider": "statusOptions",
      "joinWith": ","
    },
    {
      "name": "date",
      "label": "Thời điểm",
      "type": "daterange",
      "width": 400,
      "fromPlaceholder": "Từ ngày",
      "toPlaceholder": "Đến ngày"
    }
  ],
  "buttons": [
    {
      "text": "Tải xuống",
      "title": "Export Excel",
      "iconClass": "fas fa-file-download",
      "className": "tr-btn-export",
      "handler": "exportExcel",
      "visibleKey": "exportData"
    }
  ],
  "events": {
    "onRowClick": "onRowClick",
    "onDataLoaded": "onDataLoaded",
    "onSearchChanged": "onSearchChanged"
  }
}