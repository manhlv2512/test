{
  "schemaVersion": 1,
  "key": "transactions-block",
  "header": {
    "title": "Danh sách giao dịch phong toả tài khoản"
  },
  "detail": {
    "url": "/teamworks/executecf?processApp=GN_KHCN&serviceName=GNCN.Detail&transactionCode="
  },
  "pageSize": 10,
  "pageSizeOptions": [
    10,
    20,
    50,
    100
  ],
  "pageSizeSelect2Options": {
    "width": "72px"
  },
  "select2Options": {
    "minimumResultsForSearch": 6,
    "width": "resolve",
    "allowClear": true
  },
  "datepickerOptions": {
    "dateFormat": "dd-mm-yy",
    "showButtonPanel": true,
    "changeMonth": true,
    "changeYear": true
  },
  "columns": [
    {
      "type": "actions",
      "field": "gntdCode",
      "title": "Mã GNTD",
      "width": 135,
      "align": "left",
      "actions": [
        {
          "textField": "gntdCode",
          "href": "#",
          "title": "Open transaction detail",
          "className": "tr-transaction-link",
          "handler": "openTransactionDetail"
        }
      ]
    },
    {
      "field": "branchCode",
      "title": "ĐVKD",
      "width": 30,
      "align": "center"
    },
    {
      "field": "pdtdCode",
      "title": "Mã PDTD",
      "maxWidth": 190
    },
    {
      "field": "accBlockNo",
      "title": "Mã BT phong tỏa"
    },
    {
      "field": "customerCode",
      "title": "Mã KH",
      "align": "center"
    },
    {
      "field": "customerName",
      "title": "Tên KH",
      "minWidth": 120
    },
    {
      "field": "gnApprovalBy",
      "title": "User PDGN"
    },
    {
      "field": "gnApprovalDate",
      "title": "Ngày PDGN",
      "sortable": true,
      "align": "center"
    },
    {
      "field": "approvalBy",
      "title": "User xử lý"
    },
    {
      "field": "approvalDate",
      "title": "Thời gian xử lý",
      "sortable": true,
      "width": 135,
      "align": "center"
    },
    {
      "field": "state",
      "title": "Trạng thái",
      "renderer": "stateBadge",
      "minWidth": 120
    },
    {
      "type": "actions",
      "title": "Actions",
      "width": 110,
      "actions": [
        {
          "iconClass": "fas fa-code",
          "title": "Log xử lý",
          "href": "#",
          "handler": "viewProcessLog",
          "disabled": {
            "field": "state",
            "equals": 0
          }
        },
        {
          "href": "#",
          "variant": "warning",
          "iconClass": "fas fa-unlock",
          "title": "Giải toả tài khoản",
          "handler": "releaseBlockAmt",
          "disabled": {
            "field": "state",
            "equals": 1
          }
        }
      ]
    }
  ],
  "searchFields": [
    {
      "name": "keyword",
      "label": "Từ khoá tra cứu",
      "type": "text",
      "placeholder": "Mã GNTD hoặc Mã PDTD hoặc Mã KH hoặc Tên KH hoặc Mã BT phong tỏa",
      "width": 500
    },
    {
      "name": "branchs",
      "label": "ĐVKD",
      "type": "select",
      "placeholder": "Tất cả",
      "optionsProvider": "branchOptions",
      "valueFormatter": "formatBranch"
    },
    {
      "name": "state",
      "label": "Trạng thái",
      "type": "select",
      "placeholder": "Tất cả",
      "multiple": true,
      "joinWith": ",",
      "options": [
        {
          "value": "0",
          "label": "Chưa xử lý"
        },
        {
          "value": "1",
          "label": "Hoàn thành"
        },
        {
          "value": "2",
          "label": "Lỗi hạch toán"
        }
      ]
    },
    {
      "name": "date",
      "label": "Ngày PD giải ngân",
      "type": "daterange",
      "width": 360,
      "fromPlaceholder": "Từ ngày",
      "toPlaceholder": "đến ngày"
    }
  ],
  "buttons": [
    {
      "text": "Export Excel",
      "title": "Tải xuống",
      "iconClass": "fas fa-file-download",
      "className": "tr-btn-default",
      "handler": "exportExcel"
    }
  ],
  "events": {
    "onRowClick": "onRowClick",
    "onDataLoaded": "onDataLoaded",
    "onSearchChanged": "onSearchChanged"
  }
}