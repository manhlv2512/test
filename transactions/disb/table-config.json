{
  "schemaVersion": 1,
  "key": "transactions-disb",
  "header": {
    "title": "Danh sách giao dịch giải ngân"
  },
  "create": {
    "title": "Chọn loại giao dịch",
    "url": "/teamworks/executecf?processApp=GN_KHCN&serviceName=",
    "target": "_blank",
    "columns": 3,
    "types": [
      {
        "value": "Giaingankhoanvay",
        "label": "Giải ngân khoản vay",
        "iconClass": "fas fa-hand-holding-usd",
        "serviceName": "GNCN.Loan.Main"
      },
      {
        "value": "Giainganthauchi",
        "label": "Giải ngân thấu chi",
        "iconClass": "fas fa-credit-card",
        "serviceName": "GNCN.Overdraft.Main"
      },
      {
        "value": "Khoitaohanmuc",
        "label": "Khởi tạo hạn mức",
        "iconClass": "fas fa-file-signature",
        "serviceName": "GNCN.Limit.Main"
      },
      {
        "value": "NhapvaduyetFCC",
        "label": "Nhập và duyệt bút toán FCC",
        "iconClass": "fas fa-file-invoice-dollar",
        "serviceName": "GNCN.ApproveFcc.Main"
      },
      {
        "value": "Khac",
        "label": "Khác",
        "iconClass": "fas fa-ellipsis-h",
        "serviceName": "GNCN.Other.Main"
      }
    ]
  },
  "sla": {
    "timezone": "Asia/Ho_Chi_Minh",
    "workingDays": [
      1,
      2,
      3,
      4,
      5
    ],
    "workingHours": [
      {
        "from": "08:00",
        "to": "12:00"
      },
      {
        "from": "13:30",
        "to": "17:30"
      }
    ],
    "holidays": [
      "2026-01-01",
      "2026-04-30",
      "2026-05-01",
      "2026-09-02"
    ],
    "workingWeekends": [],
    "warningRatio": 0.8,
    "startField": "taskStartTime",
    "taskField": "status",
    "tasks": {
      "KHOI_TAO": {
        "label": "GN - Khởi tạo",
        "minutes": 120
      },
      "HACH_TOAN": {
        "label": "GN - Hạch toán",
        "minutes": 60
      },
      "DEFAULT": {
        "label": "Mặc định",
        "minutes": 240
      }
    },
    "doneStates": [
      "HOAN_THANH"
    ]
  },
  "sort": {
    "field": "createdDate",
    "type": "DESC"
  },
  "pageSize": 10,
  "pageSizeOptions": [
    10,
    20,
    50,
    100
  ],
  "pageSizeSelect2Options": {
    "width": "72px"
  },
  "select2Options": {
    "minimumResultsForSearch": 6,
    "width": "resolve",
    "allowClear": true
  },
  "datepickerOptions": {
    "dateFormat": "dd-mm-yy",
    "searchDateFormat": "yy-mm-dd",
    "showButtonPanel": true,
    "changeMonth": true,
    "changeYear": true
  },
  "columns": [
    {
      "field": "_stt",
      "title": "STT",
      "width": 50,
      "align": "center",
      "renderer": "sttRenderer"
    },
    {
      "field": "_sla",
      "title": "SLA",
      "width": 120,
      "align": "center",
      "renderer": "slaRenderer"
    },
    {
      "type": "actions",
      "title": "Mã GNTD",
      "minWidth": 160,
      "align": "left",
      "separator": false,
      "actions": [
        {
          "textField": "gntdCode",
          "href": "#",
          "title": "Xem chi tiết giao dịch",
          "className": "tr-transaction-link",
          "handler": "openTransactionDetail"
        }
      ]
    },
    {
      "field": "transactionType1Name",
      "title": "Loại giao dịch / PDTD",
      "minWidth": 170,
      "renderer": "transactionRenderer"
    },
    {
      "field": "branchCode",
      "title": "ĐVKD",
      "width": 80,
      "align": "center"
    },
    {
      "field": "customerName",
      "title": "Khách hàng",
      "minWidth": 180,
      "renderer": "customerRenderer"
    },
    {
      "field": "statusName",
      "title": "Trạng thái",
      "minWidth": 150
    },
    {
      "field": "processUser",
      "title": "User xử lý",
      "minWidth": 100
    },
    {
      "field": "assignUser",
      "title": "User phân công",
      "minWidth": 110
    },
    {
      "field": "lockUser",
      "title": "User lock",
      "minWidth": 90
    },
    {
      "field": "transactionFlowName",
      "title": "Phân luồng / Nhóm xử lý",
      "minWidth": 130,
      "renderer": "flowGroupRenderer"
    },
    {
      "field": "taskStartTime",
      "title": "Thời điểm tiếp nhận",
      "minWidth": 150,
      "align": "right",
      "sortable": true
    }
  ],
  "searchFields": [
    {
      "name": "keyword",
      "label": "Từ khoá",
      "type": "text",
      "width": 400,
      "placeholder": "Mã GNTD, mã PDTD, mã/tên KH, user xử lý"
    },
    {
      "name": "branch",
      "label": "ĐVKD",
      "type": "select",
      "width": 180,
      "placeholder": "Tất cả",
      "optionsProvider": "branchOptions"
    },
    {
      "name": "flow",
      "label": "Phân luồng",
      "type": "select",
      "width": 180,
      "placeholder": "Tất cả",
      "options": [
        {
          "value": "TT",
          "label": "Tập trung"
        },
        {
          "value": "GD_DVKD",
          "label": "GĐ ĐVKD"
        },
        {
          "value": "DVKD",
          "label": "VH ĐVKD"
        }
      ]
    },
    {
      "name": "processGroup",
      "label": "Nhóm xử lý",
      "type": "select",
      "width": 180,
      "placeholder": "Tất cả",
      "optionsProvider": "processGroupOptions"
    },
    {
      "name": "date",
      "label": "Thời điểm",
      "type": "daterange",
      "width": 360,
      "fromPlaceholder": "Từ ngày",
      "toPlaceholder": "Đến ngày"
    },
    {
      "name": "transactionType1",
      "label": "Loại giao dịch cấp 1",
      "type": "select",
      "width": 260,
      "placeholder": "Tất cả",
      "optionsProvider": "transactionType1Options"
    },
    {
      "name": "status",
      "label": "Trạng thái",
      "type": "select",
      "width": 260,
      "placeholder": "Tất cả",
      "multiple": true,
      "optionsProvider": "statusOptions",
      "joinWith": ","
    }
  ],
  "buttons": [
    {
      "text": "Khởi tạo",
      "title": "Khởi tạo giao dịch giải ngân",
      "iconClass": "fas fa-plus",
      "handler": "openCreatePopup",
      "visibleKey": "create"
    },
    {
      "text": "Tải xuống",
      "title": "Export Excel",
      "iconClass": "fas fa-file-download",
      "className": "tr-btn-default",
      "handler": "exportExcel",
      "visibleKey": "exportData"
    }
  ],
  "events": {
    "onRowClick": "onRowClick",
    "onDataLoaded": "onDataLoaded",
    "onSearchChanged": "onSearchChanged"
  }
}