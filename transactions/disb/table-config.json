  "pageSizeOptions": [
    10,
    20,
    50,
    100
  ],
  "pageSizeSelect2Options": {
    "width": "72px"
  },
  "select2Options": {
    "minimumResultsForSearch": 6,
    "width": "resolve",
    "allowClear": true
  },
  "datepickerOptions": {
    "dateFormat": "dd-mm-yy",
    "searchDateFormat": "yy-mm-dd",
    "showButtonPanel": true,
    "changeMonth": true,
    "changeYear": true
  },
  "columns": [
    {
      "field": "_stt",
      "title": "STT",
      "width": 50,
      "align": "center",
      "renderer": "sttRenderer"
    },
    {
      "field": "_sla",
      "title": "SLA",
      "align": "center",
      "renderer": "slaRenderer"
    },
    {
      "field": "gntdCode",
      "title": "Mã GNTD",
      "className": "disb-col-gntd disb-col-fit",
      "renderer": "gntdRenderer"
    },
    {
      "field": "transactionType1Name",
      "title": "Loại giao dịch / PDTD",
      "minWidth": 160,
      "renderer": "transactionRenderer"
    },
    {
      "field": "amount",
      "title": "Số tiền",
      "align": "right",
      "className1": "disb-col-fit",
      "renderer": "amountRenderer"
    },
    {
      "field": "branchCode",
      "title": "ĐVKD",
      "align": "center",
      "className": "disb-col-fit"
    },
    {
      "field": "customerName",
      "title": "Khách hàng",
      "minWidth": 140,
      "renderer": "customerRenderer"
    },
    {
      "field": "statusName",
      "title": "Trạng thái",
      "minWidth": 140,
      "maxWidth": 220,
      "renderer": "statusRenderer"
    },
    {
      "field": "transactionFlowName",
      "title": "Phân luồng / Nhóm xử lý",
      "className": "disb-col-fit",
      "renderer": "flowGroupRenderer"
    },
    {
      "field": "assignUser",
      "title": "User phân công",
      "className": "disb-col-fit"
    },
    {
      "field": "processUser",
      "title": "User xử lý",
      "className": "disb-col-fit"
    },
    {
      "field": "taskStartTime",
      "title": "Thời điểm tiếp nhận",
      "width": 110,
      "align": "right",
      "sortable": true,
      "renderer": "dateTimeRenderer"
    }
  ],
  "searchFields": [
    {
      "name": "keyword",
      "label": "Từ khoá",
      "type": "text",
      "width": 200,
      "placeholder": "GNTD, PDTD, mã/tên KH, user xử lý"
    },
    {
      "name": "branch",
      "label": "ĐVKD",
      "type": "select",
      "width": 50,
      "placeholder": "Tất cả",
      "optionsProvider": "branchOptions"
    },
    {
      "name": "flow",
      "label": "Phân luồng",
      "type": "select",
      "width": 50,
      "placeholder": "Tất cả",
      "options": [
        {
          "value": "TT",
          "label": "Tập trung"
        },
        {
          "value": "GD_DVKD",
          "label": "GĐ ĐVKD"
        },
        {
          "value": "DVKD",
          "label": "VH ĐVKD"
        }
      ]
    },
    {
      "name": "processGroup",
      "label": "Nhóm xử lý",
      "type": "select",
      "width": 50,
      "placeholder": "Tất cả",
      "optionsProvider": "processGroupOptions"
    },
    {
      "name": "date",
      "label": "Thời điểm",
      "type": "daterange",
      "width": 220,
      "fromPlaceholder": "Từ ngày",
      "toPlaceholder": "Đến ngày"
    },
    {
      "name": "transactionType1",
      "label": "Loại giao dịch cấp 1",
      "type": "select",
      "width": 140,
      "placeholder": "Tất cả",
      "optionsProvider": "transactionType1Options"
    },
    {
      "name": "status",
      "label": "Trạng thái",
      "type": "select",
      "width": 170,
      "placeholder": "Tất cả",
      "multiple": true,
      "optionsProvider": "statusOptions",
      "joinWith": ","
    }
  ],
  "buttons": [
    {
      "text": "Khởi tạo",
      "title": "Khởi tạo giao dịch giải ngân",
      "iconClass": "fas fa-plus",
      "className": "tr-btn-default",
      "handler": "openCreatePopup",
      "visibleKey": "create"
    },
    {
      "text": "Tải xuống",
      "title": "Export Excel",
      "iconClass": "fas fa-file-download",
      "className": "tr-btn-export",
      "handler": "exportExcel",
      "visibleKey": "exportData"
    }
  ],
  "events": {
    "onRowClick": "onRowClick",
    "onDataLoaded": "onDataLoaded",
    "onSearchChanged": "onSearchChanged"
  }
}