{
  "schemaVersion": 1,
  "key": "transactions",
  "header1": {
    "title": "Transaction Management",
    "description": "Search, review and manage transaction records"
  },
  "pageSize": 10,
  "pageSizeOptions": [10, 20, 50, 100],
  "pageSizeSelect2Options": {
    "width": "72px"
  },
  "select2Options": {
    "minimumResultsForSearch": 6,
    "width": "resolve",
    "allowClear": true
  },
  "datepickerOptions": {
    "dateFormat": "dd-mm-yy",
    "showButtonPanel": true,
    "changeMonth": true,
    "changeYear": true
  },
  "columns": [
    {
      "field": "id",
      "title": "No.",
      "width": 50,
      "sortable": true
    },
    {
      "type": "actions",
      "title": "Transaction Code",
      "width": 100,
      "sortable": true,
      "actions": [
        {
          "textField": "transactionCode",
          "href": "#",
          "title": "Open transaction detail",
          "className": "tr-transaction-link",
          "handler": "openTransactionDetail"
        }
      ]
    },
    {
      "field": "name",
      "title": "Document Name",
      "sortable": true
    },
    {
      "field": "owner",
      "title": "Owner",
      "sortable": true
    },
    {
      "field": "amount",
      "title": "Amount",
      "sortable": true,
      "renderer": "currency"
    },
    {
      "field": "status",
      "title": "Status",
      "sortable": true,
      "renderer": "statusBadge"
    },
    {
      "field": "createdDate",
      "title": "Created Date",
      "sortable": true
    },
    {
      "type": "actions",
      "title": "Actions",
      "width": 110,
      "actions": [
        {
          "text": "View detail",
          "href": "#",
          "title": "View document detail",
          "handler": "viewDocumentDetail"
        }
      ]
    }
  ],
  "searchFields": [
    {
      "name": "keyword",
      "label": "Keyword",
      "type": "text",
      "width": 280,
      "placeholder": "transaction code, name or owner"
    },
    {
      "name": "status",
      "label": "Status",
      "type": "select",
      "width": 200,
      "placeholder": "All statuses",
      "options": [
        { "value": "OPEN", "label": "Open" },
        { "value": "CLOSED", "label": "Closed" },
        { "value": "PENDING", "label": "Pending" }
      ]
    },
    {
      "name": "owner",
      "label": "Owner",
      "type": "select",
      "width": 200,
      "placeholder": "All owners",
      "options": [
        { "value": "Alice", "label": "Alice" },
        { "value": "Bob", "label": "Bob" },
        { "value": "Charlie", "label": "Charlie" },
        { "value": "Diana", "label": "Diana" },
        { "value": "Evan", "label": "Evan" }
      ]
    },
    {
      "name": "createdDate",
      "label": "Created Date",
      "type": "daterange",
      "width": 360,
      "fromPlaceholder": "From date",
      "toPlaceholder": "To date"
    }
  ],
  "buttons": [
    {
      "type": "dropdown",
      "iconClass": "fas fa-ellipsis-h",
      "title": "Table actions",
      "actions": [
        {
          "text": "Export Excel",
          "iconClass": "fas fa-file-export",
          "className": "tr-toolbar-menu-export",
          "handler": "exportExcel"
        },
        {
          "text": "Import",
          "iconClass": "fas fa-file-import",
          "className": "tr-toolbar-menu-import",
          "handler": "importExcel"
        },
        {
          "text": "Delete all",
          "iconClass": "fas fa-trash-alt",
          "className": "tr-toolbar-menu-danger",
          "handler": "deleteAll"
        }
      ]
    }
  ],
  "events": {
    "onRowClick": "onRowClick",
    "onDataLoaded": "onDataLoaded",
    "onSearchChanged": "onSearchChanged"
  }
}