# ------------------------------------------------------------------
# node-shell-api configuration (copy to .env and edit)
# ------------------------------------------------------------------

# --- HTTP server ---
PORT=3000
HOST=0.0.0.0

# API key required in the `x-api-key` header. Leave empty to DISABLE auth
# (not recommended in production).
API_KEY=change-me-to-a-long-random-string

# --- Execution mode ---
# local : run scripts/execute.sh inside the container (DEV on macOS / testing)
# ssh   : run the command on a remote RedHat host via SSH (UAT / PROD)
EXEC_MODE=local

# --- Common ---
DATA_DIR=/data
LOG_DIR=/logs
EXEC_TIMEOUT_MS=120000
MAX_OUTPUT_BYTES=1048576

# --- LOCAL mode (EXEC_MODE=local) ---
SCRIPT_PATH=/scripts/execute.sh
SHELL_BIN=/bin/bash
WORK_DIR=/scripts

# --- SSH mode (EXEC_MODE=ssh) ---
# Target host where admin.sh / install.py actually run (user@host).
SSH_HOST=appuser@uat-host.internal
# Bastion / jump host (user@host). Leave EMPTY for a direct connection.
# UAT & PROD both go through their own bastion here.
SSH_JUMP=jumpuser@bastion-uat.internal
SSH_PORT=22
# Path INSIDE the container to the private key (mounted from HOST_SSH_DIR).
SSH_KEY=/root/.ssh/id_rsa
# Command executed on the TARGET host. {{ARGS}} is replaced by API args.
SSH_REMOTE_COMMAND=cd /opt/app && ./admin.sh -f /local/install.py {{ARGS}}
# Optional extra ssh -o options, comma separated. Example:
# SSH_EXTRA_OPTIONS=ServerAliveInterval=30,ServerAliveCountMax=3
SSH_EXTRA_OPTIONS=

# --- Host paths for docker-compose volumes ---
HOST_SCRIPTS_DIR=./scripts
HOST_DATA_DIR=./data
HOST_LOGS_DIR=./logs
# Folder on the host that contains the private key referenced by SSH_KEY.
HOST_SSH_DIR=./ssh
